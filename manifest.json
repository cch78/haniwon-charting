{
  "manifest_version": 3,
  "name": "한의원 진료 차팅 시스템",
  "version": "2.12",
  "description": "한의맥 연동 + Claude AI + Whisper STT + 구글 시트 저장 + 카카오톡 발송",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "downloads",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://web.kakao.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "guide_prompt.md",
        "autoupdate.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}